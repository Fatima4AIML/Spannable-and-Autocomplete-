<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to Our Application"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#800080"
            android:gravity="center"
            android:padding="12dp"/>

        <TextView
            android:id="@+id/txtView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="27sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. AutoComplete with ArrayAdapter"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#800080"
            android:layout_marginBottom="8dp"/>

        <AutoCompleteTextView
            android:id="@+id/arrayAutoComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="Type a country name"
            android:textColor="#000000"
            android:padding="12dp"
            android:completionThreshold="1"
            android:singleLine="true"
            android:backgroundTint="#800080"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. AutoComplete with CustomAdapter"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#800080"
            android:layout_marginTop="80dp"
            android:layout_marginBottom="8dp"/>

        <AutoCompleteTextView
            android:id="@+id/customAutoComplete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="Search a country"
            android:textColor="#000000"
            android:padding="12dp"
            android:completionThreshold="1"
            android:singleLine="true"
            android:backgroundTint="#800080"/>

        <Button
            android:id="@+id/btnClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="Clear"
            android:textColor="#FFFFFF"
            android:backgroundTint="#800080" />

    </LinearLayout>
</ScrollView>